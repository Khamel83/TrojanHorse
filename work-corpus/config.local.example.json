{
  "_comment": "Copy to config.local.json and include only overrides needed on this machine.",
  "inventory": {
    "follow_directory_symlinks": true,
    "hash_files_up_to_mb": 32
  },
  "normalization": {
    "include_unclassified_sources": true,
    "skip_classifications": [],
    "max_table_rows": 100000
  },
  "zoom": {
    "engine": "custom",
    "language": "en",
    "model": "parakeet-pro:nvidia_parakeet-v3_494MB",
    "custom_command": [
      "/usr/local/bin/mw",
      "transcribe",
      "{input}",
      "--model",
      "parakeet-pro:nvidia_parakeet-v3_494MB",
      "--language",
      "{language}",
      "--speakers",
      "--format",
      "vtt",
      "-o",
      "{output_vtt}"
    ]
  },
  "onenote": {
    "converter_root": "/path/to/onenote-exporter",
    "converter_version": "onenote-exporter@local-with-pyonenote-terminator-256",
    "converter_command": [
      "/path/to/onenote-exporter-venv/bin/python",
      "/path/to/TrojanHorse/work-corpus/scripts/onenote_export_one.py",
      "{input}",
      "{output}"
    ]
  },
  "source_roots": {
    "zoom": "data/Zoom"
  }
}
